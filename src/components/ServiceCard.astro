---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-lg bg-ink-800">
  {
    image && (
      <img
        src={image}
        alt={imageAlt ?? ''}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col border-l-[3px] border-brand-500 p-6">
    <h3 class="text-xl leading-snug text-paper-50 sm:text-2xl">{title}</h3>
    <p class="mt-3 text-base leading-relaxed text-paper-300 sm:text-lg">
      {description}
    </p>
  </div>
</article>
