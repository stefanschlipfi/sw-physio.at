---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 px-5 py-8 sm:px-10">
  <div class="container-page">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <p class="font-display text-2xl leading-tight text-brand-500">
        <strong class="font-bold">Physiotherapie</strong><br />{site.owner}
      </p>

      <nav aria-label="Rechtliches" class="flex items-center gap-8">
        <a href="/impressum/" class="text-paper-50 transition hover:text-brand-500">
          Impressum
        </a>
        <a href="/agb/" class="text-paper-50 transition hover:text-brand-500">
          AGBs
        </a>
      </nav>
    </div>

    {/* The orange hairline that closed the Webflow footer. */}
    <div class="my-5 h-px w-full bg-brand-500"></div>

    <div
      class="flex flex-col gap-2 text-sm text-paper-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}</p>
      <a
        href="/admin/"
        rel="nofollow"
        class="transition hover:text-paper-200"
        title="Inhalte bearbeiten"
      >
        Redaktion
      </a>
    </div>
  </div>
</footer>
