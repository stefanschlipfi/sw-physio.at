---
interface Props {
  entries: { period: string; description: string }[];
}

const { entries } = Astro.props;
---

{/*
  Vertical timeline: a rail down the left, one marker per station, the year
  range as the anchor. `<ol>` because the stations are in chronological order –
  screen readers announce them as a numbered sequence.
*/}
<ol class="relative mt-6 border-l-2 border-brand-500/40 pl-6">
  {
    entries.map((entry) => (
      <li class="relative pb-8 last:pb-0">
        <span
          class="absolute -left-[2.0625rem] top-2 size-4 rounded-full border-2 border-brand-500 bg-ink-950"
          aria-hidden="true"
        />
        <p class="text-xl font-bold leading-tight text-brand-500">
          {entry.period}
        </p>
        <p class="mt-1.5 text-base leading-relaxed text-paper-300 sm:text-lg">
          {entry.description}
        </p>
      </li>
    ))
  }
</ol>
