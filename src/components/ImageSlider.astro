---
interface Props {
  slides: { image: string; imageAlt?: string; title?: string }[];
  /** Overlay headline on the first slide, as the Webflow slider had it. */
  caption?: string;
}

const { slides, caption } = Astro.props;
---

{
  slides.length > 0 && (
    <section
      class="relative z-10 h-[70svh] min-h-96 w-full overflow-hidden bg-ink-950"
      data-slider
      aria-roledescription="Karussell"
      aria-label={caption ?? 'Bildergalerie'}
    >
      <ul class="h-full">
        {slides.map((slide, index) => (
          <li
            class="absolute inset-0 transition-opacity duration-500 data-[active=false]:pointer-events-none data-[active=false]:opacity-0"
            data-slide
            data-active={index === 0 ? 'true' : 'false'}
            aria-hidden={index === 0 ? undefined : 'true'}
          >
            <img
              src={slide.image}
              alt={slide.imageAlt ?? slide.title ?? ''}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="size-full object-cover"
            />
            {index === 0 && caption && (
              <div class="absolute inset-0 flex items-center justify-center bg-ink-950/35">
                <h2 class="px-6 text-center text-4xl text-paper-50 sm:text-6xl">
                  {caption}
                </h2>
              </div>
            )}
          </li>
        ))}
      </ul>

      {slides.length > 1 && (
        <>
          <button
            type="button"
            data-slider-prev
            class="absolute left-3 top-1/2 z-10 grid size-12 -translate-y-1/2 place-items-center bg-ink-950/60 text-paper-50 transition hover:text-brand-500"
          >
            <span class="sr-only">Vorheriges Bild</span>
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>

          <button
            type="button"
            data-slider-next
            class="absolute right-3 top-1/2 z-10 grid size-12 -translate-y-1/2 place-items-center bg-ink-950/60 text-paper-50 transition hover:text-brand-500"
          >
            <span class="sr-only">Nächstes Bild</span>
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <div class="absolute inset-x-0 bottom-5 z-10 flex justify-center gap-3">
            {slides.map((_, index) => (
              <button
                type="button"
                data-slider-dot
                data-index={index}
                aria-current={index === 0 ? 'true' : 'false'}
                class="size-3 rounded-full bg-paper-50/50 transition aria-[current=true]:bg-brand-500"
              >
                <span class="sr-only">Bild {index + 1}</span>
              </button>
            ))}
          </div>
        </>
      )}
    </section>
  )
}

<script>
  for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    if (slides.length < 2) continue;

    let position = 0;

    const show = (next: number) => {
      position = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === position;
        slide.dataset.active = String(active);
        slide.toggleAttribute('aria-hidden', !active);
      });
      dots.forEach((dot, index) => {
        dot.setAttribute('aria-current', String(index === position));
      });
    };

    slider
      .querySelector('[data-slider-prev]')
      ?.addEventListener('click', () => show(position - 1));
    slider
      .querySelector('[data-slider-next]')
      ?.addEventListener('click', () => show(position + 1));

    for (const dot of dots) {
      dot.addEventListener('click', () => show(Number(dot.dataset.index)));
    }
  }
</script>
