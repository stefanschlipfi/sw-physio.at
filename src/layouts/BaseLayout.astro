---
import { SEO } from 'astro-seo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, addressOneLine, navigation } from '../lib/site';
import { getOpeningHours, schemaOpeningHours } from '../lib/opening-hours';

interface Props {
  title?: string;
  description?: string;
  /**
   * Preview image for social networks, relative to the site root. Without it
   * the site-wide default applies. Its dimensions are only announced for that
   * default, so a page passing its own image stays silent about them.
   */
  image?: string;
}

const { title, description = site.description, image } = Astro.props;

const pageTitle = title ? `${title} – ${site.name}` : site.name;
const baseUrl = Astro.site ?? site.domain;
const canonical = new URL(Astro.url.pathname, baseUrl).href;

/** Open Graph needs an absolute URL, a relative path is ignored by the crawlers. */
const previewImage = new URL(image ?? site.ogImage.path, baseUrl).href;
const previewSize = image
  ? {}
  : {
      type: site.ogImage.type,
      width: site.ogImage.width,
      height: site.ogImage.height,
    };

const days = await getOpeningHours();

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: site.address.street,
  postalCode: site.address.postalCode,
  addressLocality: site.address.city,
  addressRegion: site.address.state,
  addressCountry: 'AT',
};

/**
 * A one-person physiotherapy practice is a `Physiotherapy` business in
 * schema.org – a MedicalBusiness, which carries opening hours, address and
 * geo coordinates itself. No separate Place is needed here.
 */
const practiceSchema = {
  '@type': 'Physiotherapy',
  name: site.name,
  description: site.description,
  url: site.domain,
  telephone: site.phone,
  email: site.email,
  image: previewImage,
  address: postalAddress,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: schemaOpeningHours(days),
  sameAs: [site.social.instagram].filter(Boolean),
  founder: { '@type': 'Person', name: site.owner },
};

/**
 * Breadcrumb trail for the sub-pages. The labels come from the navigation so
 * they cannot drift apart from the ones a visitor sees in the header.
 */
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: navigation.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href, baseUrl).href,
  })),
};

/**
 * Both schemas travel in one `@graph` – a page may carry several ld+json
 * blocks, but a single graph keeps `@context` in one place.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [practiceSchema, breadcrumbSchema],
};
---

<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Title, description, canonical, robots and the Open Graph tags. The
        remaining tags below are not SEO and stay plain markup. */}
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: pageTitle,
          type: 'website',
          image: previewImage,
          url: canonical,
        },
        optional: {
          siteName: site.name,
          description,
          locale: 'de_AT',
        },
        image: { alt: site.claim, ...previewSize },
      }}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />

    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#ce6707" />

    <meta name="geo.region" content="AT-3" />
    <meta name="geo.placename" content={addressOneLine} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=Roboto:wght@400;700&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-brand-500 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Zum Inhalt springen
    </a>
    <Header />
    {/* Offsets the fixed header so the first section starts below it. */}
    <main id="content" class="flex-1 pt-[4.75rem]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
